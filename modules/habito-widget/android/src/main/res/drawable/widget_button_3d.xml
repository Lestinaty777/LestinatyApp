<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Capa inferior: Extrusión 3D sombreada física -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/widget_boton_extrusion" />
        </shape>
    </item>

    <!-- Capa superior: Cara frontal del botón con bisel reflectante -->
    <item android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/widget_boton_cara" />
            <stroke
                android:width="1.5dp"
                android:color="@color/widget_boton_bisel" />
        </shape>
    </item>
</layer-list>
