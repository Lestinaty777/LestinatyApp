<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Capa inferior: Sombra suave -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#4086E097" />
        </shape>
    </item>

    <!-- Capa superior: Medallón de cristal menta completado -->
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/widget_completado_fondo" />
            <stroke
                android:width="1.5dp"
                android:color="@color/widget_completado_borde" />
        </shape>
    </item>
</layer-list>
