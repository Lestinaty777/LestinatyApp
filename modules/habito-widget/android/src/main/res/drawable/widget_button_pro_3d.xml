<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Capa inferior: Extrusión 3D púrpura profunda -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/widget_pro_extrusion" />
        </shape>
    </item>

    <!-- Capa superior: Cara frontal púrpura real con bisel blanco -->
    <item android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/widget_pro_cara" />
            <stroke
                android:width="1.5dp"
                android:color="#70FFFFFF" />
        </shape>
    </item>
</layer-list>
