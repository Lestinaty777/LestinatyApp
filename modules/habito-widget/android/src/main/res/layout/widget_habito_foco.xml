<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_masterglass_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Diorama hero: la ilustración de la etapa domina el widget. Racha y
         botón de acción flotan sobre sus esquinas superiores en vez de
         ocupar una fila propia, y el nombre del hábito se escribe sobre un
         degradado oscuro al pie de la imagen, tipo póster. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/widget_etapa_imagen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Etapa del hábito"
            android:scaleType="fitCenter" />

        <!-- Degradado inferior para que el nombre sea legible sobre la imagen -->
        <View
            android:id="@+id/widget_scrim"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_gravity="bottom"
            android:background="@drawable/widget_scrim_etapa" />

        <!-- Chip de racha de fuego, flotando sobre la esquina superior izquierda -->
        <LinearLayout
            android:id="@+id/widget_racha_chip"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_gravity="top|start"
            android:layout_margin="6dp"
            android:background="@drawable/widget_streak_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="7dp"
            android:paddingEnd="9dp">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginEnd="4dp"
                android:contentDescription="Fuego"
                android:src="@drawable/ic_widget_flame" />

            <TextView
                android:id="@+id/widget_racha_texto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 d"
                android:textColor="@color/widget_racha_texto"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- MasterButton 3D interactivo con extrusión, esquina superior derecha -->
        <FrameLayout
            android:id="@+id/widget_boton_accion"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:background="@drawable/widget_button_3d"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/widget_boton_icono"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="Acción"
                android:src="@drawable/ic_widget_plus" />
        </FrameLayout>

        <!-- Nombre del hábito, sobre el degradado -->
        <TextView
            android:id="@+id/widget_titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingHorizontal="8dp"
            android:paddingBottom="8dp"
            android:text="Mi Hábito"
            android:textColor="@color/widget_titulo_sobre_imagen"
            android:textSize="14sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Calendario semanal sencillo: 7 celdas, lunes a domingo. La letra de
         cada día es fija en el XML — solo el fondo (estado) y el color de
         texto cambian en tiempo de ejecución, así cada celda puede tener un
         id propio sin depender de un <include> con ids hijos repetidos
         (RemoteViews resuelve por id contra TODO el árbol, no por instancia). -->
    <LinearLayout
        android:id="@+id/widget_semana_fila"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_dia_1"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_dia_bg_no_programado"
            android:gravity="center"
            android:text="L"
            android:textColor="@color/widget_dia_texto_oscuro"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_dia_2"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_dia_bg_no_programado"
            android:gravity="center"
            android:text="M"
            android:textColor="@color/widget_dia_texto_oscuro"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_dia_3"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_dia_bg_no_programado"
            android:gravity="center"
            android:text="X"
            android:textColor="@color/widget_dia_texto_oscuro"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_dia_4"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_dia_bg_no_programado"
            android:gravity="center"
            android:text="J"
            android:textColor="@color/widget_dia_texto_oscuro"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_dia_5"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_dia_bg_no_programado"
            android:gravity="center"
            android:text="V"
            android:textColor="@color/widget_dia_texto_oscuro"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_dia_6"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_dia_bg_no_programado"
            android:gravity="center"
            android:text="S"
            android:textColor="@color/widget_dia_texto_oscuro"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_dia_7"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_weight="1"
            android:background="@drawable/widget_dia_bg_no_programado"
            android:gravity="center"
            android:text="D"
            android:textColor="@color/widget_dia_texto_oscuro"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Estado sin hábitos -->
    <TextView
        android:id="@+id/widget_progreso_texto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="0 / 1"
        android:textColor="@color/widget_texto_secundario"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
