EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# API keys PÚBLICAS de RevenueCat (Project settings -> API keys). No es el
# secret key (sk_...) — esas nunca van en el cliente.
EXPO_PUBLIC_REVENUECAT_APPLE_KEY=
EXPO_PUBLIC_REVENUECAT_GOOGLE_KEY=
# Web OAuth client ID de Google Cloud Console (no el Android client ID) —
# el mismo valor va también en Supabase Dashboard > Authentication > Providers > Google.
# Android únicamente — no se usa ni se exige en iOS.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# 'true' habilita Aby remoto (Gemini vía Edge Function). Requerido para pasar
# la validación de entorno de build production/preview.
EXPO_PUBLIC_ABY_REMOTO=

# Analítica de producto (opcional). Sin clave no se envía ningún evento.
# Solo se envía si la persona activó "analítica de producto" en sus permisos.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
