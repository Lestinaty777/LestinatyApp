EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# API keys PÚBLICAS de RevenueCat (Project settings -> API keys). No es el
# secret key (sk_...) — esas nunca van en el cliente.
EXPO_PUBLIC_REVENUECAT_APPLE_KEY=
EXPO_PUBLIC_REVENUECAT_GOOGLE_KEY=
# Web OAuth client ID de Google Cloud Console (no el Android client ID) —
# el mismo valor va también en Supabase Dashboard > Authentication > Providers > Google.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
